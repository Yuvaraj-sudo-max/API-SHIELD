# ==========================================
# API Shield Configuration Example
# Copy this file to .env and configure values
# ==========================================

# Gateway Admin Secret Key
API_KEY=your_super_secret_shield_api_key_here

# DeepSeek AI API Key for Intelligent Threat Analysis & Chat Gateway
# Get your API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Redis Configuration (Optional - falls back to InMemoryStore if unavailable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Flask Configuration
PORT=5000
DEBUG=False
